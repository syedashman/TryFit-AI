APP_NAME=TryFit AI
APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]
MAX_IMAGE_SIZE_MB=15
STORAGE_DIR=storage

MIN_PERSON_IMAGES=3
MAX_PERSON_IMAGES=5
PERSON_MIN_WIDTH=400
PERSON_MIN_HEIGHT=500
PERSON_MIN_SHARPNESS=35
IDENTITY_CONSISTENCY_THRESHOLD=0.80
IDENTITY_HARD_REJECT_THRESHOLD=0.55

VTON_PROVIDER=vertex
PROVIDER_FALLBACK_ORDER=["vertex","catvton"]
PROVIDER_RUNTIME_MAX_RETRIES=1
PROVIDER_RUNTIME_BACKOFF_SECONDS=0.25
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30
PROVIDER_HEALTH_CACHE_TTL_SECONDS=15

GOOGLE_CLOUD_PROJECT=your-gcp-project-id-here
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_MODEL=virtual-try-on-001
VERTEX_SAMPLE_COUNT=1
VERTEX_CANDIDATE_COUNT=3
VERTEX_STORAGE_URI=
VERTEX_REQUEST_TIMEOUT_SECONDS=180
VERTEX_MAX_RETRIES=2
VERTEX_RETRY_BACKOFF_SECONDS=1.0
GEOMETRY_SELECTION_ENABLED=true
FULL_BODY_PRIORITY=true
DUAL_REFERENCE_ENABLED=true

COMMERCIAL_API_ENABLED=true
COMMERCIAL_QUALITY_THRESHOLD=0.86
COMMERCIAL_MAX_GENERATION_ROUNDS=2
COMMERCIAL_REJECT_DISTORTED_RESULTS=true

HF_SPACE=zhengchong/CatVTON
HF_API_NAME=/submit_function
HF_FALLBACK_API_NAME=/submit_function_p2p
HF_ENABLE_FALLBACK=true
HF_TOKEN=your-huggingface-token-here
HF_INPUT_MODE=editor
HF_CLOTH_TYPE=overall
HF_SHOW_TYPE=result only
HF_NUM_INFERENCE_STEPS=50
HF_GUIDANCE_SCALE=2.5
HF_SEED=42

# Sprint 4 Phase 2 visual refinement
VISUAL_ENHANCEMENT_ENABLED=true
VISUAL_ENHANCEMENT_SHARPNESS=1.08
VISUAL_ENHANCEMENT_CONTRAST=1.03
VISUAL_ENHANCEMENT_COLOR=1.01
